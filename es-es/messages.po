msgstr ""
"Verifica que el contenedor MySQL/MariaDB esté en ejecución, luego crea la "
"base de datos, el usuario y otorga todos los privilegios."

#: internal/web/templates/manager/wp/install.html:301
msgid "Creating database & MySQL user"
msgstr "Creando base de datos y usuario MySQL"

#: internal/web/templates/manager/wp/install.html:305
