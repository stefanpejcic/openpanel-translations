msgstr "Comprobar el núcleo de WP"

#: internal/web/templates/manager/wp/single.html:716
#: internal/web/templates/manager/wp/single.html:787
msgid "Check all plugins"
msgstr "Comprobar todos los plugins"

#: internal/web/templates/manager/wp/single.html:737
msgid "Checking integrity of WP Core files... Please wait."
msgstr ""
"Verificando la integridad de los archivos del núcleo de WP... Por favor, "
"espere."

#: internal/web/templates/manager/wp/single.html:764
msgid "An error occurred while verifying checksums."
msgstr "Se produjo un error al verificar las sumas de comprobación."

#: internal/web/templates/manager/wp/single.html:773
msgid "Checking integrity for all WordPress plugins... Please wait."
msgstr ""
"Verificando la integridad de todos los plugins de WordPress... Por favor, "
"espere."

#: internal/web/templates/manager/wp/single.html:800
msgid "An error occurred while verifying plugins checksums."
msgstr ""
"Se produjo un error al verificar las sumas de comprobación de los plugins."

#: internal/web/templates/manager/wp/single.html:822
msgid "Reinstall"
msgstr "Reinstalar"

#: internal/web/templates/manager/wp/single.html:827
msgid ""
"If checksums fail to match, you can quickly reinstall WordPress core files "
