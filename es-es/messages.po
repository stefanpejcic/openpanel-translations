msgid ""
"Generates 8 unique cryptographic secret keys and salts and writes them into "
"wp-config.php to secure cookies and sessions."
msgstr ""
"Genera 8 claves secretas criptográficas únicas y sales y las escribe en wp-"
"config.php para proteger las cookies y sesiones."

