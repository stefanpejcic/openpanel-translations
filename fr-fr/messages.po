#: internal/web/templates/manager/sofawiki_app.html:101
msgid ""
"SofaWiki's own setup wizard runs the first time the site is opened in a "
"browser: it fixes folder permissions, creates the configuration, sets an "
"admin login, and writes the main page. Visit the site to complete it."
msgstr ""
"L'assistant de configuration propre à SofaWiki s'exécute la première fois "
"que le site est ouvert dans un navigateur : il corrige les permissions des "
"dossiers, crée la configuration, définit un identifiant administrateur et "
"écrit la page principale. Visitez le site pour le finaliser."

#: internal/web/templates/manager/sofawiki_app.html:125
msgid "Clone a SofaWiki instance's files to another domain or subdirectory."
msgstr ""
"Cloner les fichiers d'une instance SofaWiki vers un autre domaine ou sous-"
"répertoire."

#: internal/web/templates/manager/sofawiki_app.html:146
msgid "Remove the SofaWiki wiki from Site Manager."
msgstr "Supprimer le wiki SofaWiki du Gestionnaire de sites."

#: internal/web/templates/manager/sofawiki_app.html:149
msgid ""
"Remove the SofaWiki wiki from this manager without actually deleting any "
"files."
msgstr ""
"Supprimer le wiki SofaWiki de ce gestionnaire sans supprimer réellement "
"aucun fichier."

#: internal/web/templates/manager/sofawiki_app.html:152
msgid "Detach SofaWiki"
msgstr "Détacher SofaWiki"

#: internal/web/templates/manager/sofawiki_app.html:162
