#: internal/web/templates/manager/wp/install.html:49
msgid "Just another WordPress site"
msgstr "Ещё один сайт на WordPress"

#: internal/web/templates/manager/wp/install.html:56
msgid "WordPress version"
msgstr "Версия WordPress"

#: internal/web/templates/manager/wp/install.html:191
msgid "Table prefix"
msgstr "Префикс таблиц"

#: internal/web/templates/manager/wp/install.html:235
msgid ""
"Validates provided data, checks if install already exists, fetches PHP "
"version and folder for the domain. Checks the assigned PHP version and "
"webservers, confirms the containers are available, and starts them if "
"needed."
msgstr ""
"Проверяет предоставленные данные, проверяет, не существует ли уже установка,"
" получает версию PHP и папку для домена. Проверяет назначенную версию PHP и "
"веб-серверы, подтверждает доступность контейнеров и запускает их при "
"необходимости."

#: internal/web/templates/manager/wp/install.html:241
msgid ""
"Downloads the WordPress .tar.gz archive from wordpress.org, or reuses a "
"local copy if already present."
msgstr ""
"Загружает архив WordPress .tar.gz с wordpress.org или использует локальную "
"копию, если она уже есть."

#: internal/web/templates/manager/wp/install.html:243
msgid "Downloading WordPress archive"
msgstr "Загрузка архива WordPress"

#: internal/web/templates/manager/wp/install.html:247
msgid "Extracts all WordPress core files into the domain folder."
msgstr "Распаковывает все файлы ядра WordPress в папку домена."

#: internal/web/templates/manager/wp/install.html:253
msgid ""
"Creates the .htaccess file with rewrite rules, adds database credentials to "
"wp-config.php, and adds the mu-plugin for HTTPS behind Varnish."
msgstr ""
"Создаёт файл .htaccess с правилами перезаписи, добавляет учётные данные базы"
" данных в wp-config.php и добавляет mu-плагин для HTTPS за Varnish."

#: internal/web/templates/manager/wp/install.html:255
msgid "Creating .htaccess & writing wp-config.php"
msgstr "Создание .htaccess и запись wp-config.php"

#: internal/web/templates/manager/wp/install.html:259
msgid ""
"Generates 8 unique cryptographic secret keys and salts and writes them into "
"wp-config.php to secure cookies and sessions."
msgstr ""
"Генерирует 8 уникальных криптографических секретных ключей и солей и "
"записывает их в wp-config.php для защиты куки и сессий."

#: internal/web/templates/manager/wp/install.html:261
msgid "Generating security keys & salts"
msgstr "Генерация ключей безопасности и солей"

#: internal/web/templates/manager/wp/install.html:265
msgid ""
"Sets ownership of all files to the correct system user so the web server and"
" PHP can read and write them."
msgstr ""
"Назначает всем файлам владельцем нужного системного пользователя, чтобы веб-"
"сервер и PHP могли их читать и записывать."

#: internal/web/templates/manager/wp/install.html:267
msgid "Setting file permissions & ownership"
msgstr "Настройка прав доступа и владельца файлов"

#: internal/web/templates/manager/wp/install.html:271
msgid ""
"Runs wp --info inside the PHP container to confirm WP-CLI is functional "
"before attempting any database operations."
msgstr ""
"Выполняет wp --info внутри PHP-контейнера, чтобы убедиться в "
"работоспособности WP-CLI перед операциями с базой данных."

#: internal/web/templates/manager/wp/install.html:273
msgid "Testing WP-CLI commands"
msgstr "Проверка команд WP-CLI"

#: internal/web/templates/manager/wp/install.html:277
msgid ""
"Verifies the MySQL/MariaDB container is running, then creates the database, "
"user, and grants all privileges."
msgstr ""
"Проверяет, что контейнер MySQL/MariaDB запущен, затем создаёт базу данных, "
"пользователя и предоставляет все привилегии."

#: internal/web/templates/manager/wp/install.html:279
msgid "Creating database & MySQL user"
msgstr "Создание базы данных и пользователя MySQL"

#: internal/web/templates/manager/wp/install.html:283
msgid ""
"Runs wp core install via WP-CLI to create all WordPress tables, set the site"
" URL, title, and admin account."
msgstr ""
"Выполняет wp core install через WP-CLI для создания всех таблиц WordPress, "
"установки URL сайта, заголовка и учётной записи администратора."

#: internal/web/templates/manager/wp/install.html:285
msgid "Importing tables into database"
msgstr "Импорт таблиц в базу данных"

#: internal/web/templates/manager/wp/install.html:289
msgid "Sets pretty permalink structure and the site tagline."
msgstr "Устанавливает удобную структуру постоянных ссылок и слоган сайта."

#: internal/web/templates/manager/wp/install.html:291
msgid "Configuring permalinks & site settings"
msgstr "Настройка постоянных ссылок и параметров сайта"

#: internal/web/templates/manager/wp/install.html:295
msgid ""
"Installs the WP-CLI Login Command package so you can jump directly into wp-"
"admin from WP Manager without entering credentials."
msgstr ""
"Устанавливает пакет WP-CLI Login Command, чтобы вы могли переходить прямо в "
"wp-admin из WP Manager без ввода учётных данных."

#: internal/web/templates/manager/wp/install.html:297
msgid "Installing auto-login plugin"
msgstr "Установка плагина автоматического входа"

#: internal/web/templates/manager/wp/install.html:301
msgid ""
"Checks for server-wide or user-specific plugins and themes sets and installs"
" them via WP-CLI."
msgstr ""
"Проверяет наличие серверных или пользовательских наборов плагинов и тем и "
"устанавливает их через WP-CLI."

#: internal/web/templates/manager/wp/install.html:303
msgid "Checking and installing plugins & themes sets"
msgstr "Проверка и установка наборов плагинов и тем"

#: internal/web/templates/manager/wp/install.html:307
msgid ""
"Records the installation in the database so the site appears in WP Manager."
msgstr "Записывает установку в базу данных, чтобы сайт появился в WP Manager."

#: internal/web/templates/manager/wp/install.html:329
msgid "Install in progress for"
msgstr "Установка выполняется для"

