#: openpanel/internal/web/templates/manager/app_install.html:408
msgid "Generate"
msgstr "Сгенерировать"

#: openpanel/internal/web/templates/manager/app_install.html:414
msgid "8-64 characters. You'll use this to log into n8n after install."
msgstr "8–64 символа. Он понадобится для входа в n8n после установки."

#: openpanel/internal/web/templates/manager/app_install.html:444
msgid "Advanced options"
msgstr "Дополнительные параметры"

#: openpanel/internal/web/templates/manager/app_install.html:466
msgid "Restrict CPU cores that the container can use."
msgstr "Ограничить число ядер CPU, доступных контейнеру."

#: openpanel/internal/web/templates/manager/app_install.html:480
