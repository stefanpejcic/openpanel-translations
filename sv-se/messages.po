#: internal/web/templates/dashboard/onboarding.html:278
#: internal/web/templates/dashboard/onboarding.html:351
msgid "Passkey"
msgstr "Nyckel (Passkey)"

#: internal/web/templates/dashboard/onboarding.html:281
msgid ""
"Sign in with your device's fingerprint, face recognition, or a security key "
"- no password needed."
msgstr ""
"Logga in med fingeravtryck, ansiktsigenkänning eller en säkerhetsnyckel – "
"inget lösenord behövs."

#: internal/web/templates/dashboard/onboarding.html:318
msgid ""
"Enter one IP address or CIDR range per line. Leave empty to allow all IPs."
msgstr ""
"Ange en IP-adress eller ett CIDR-intervall per rad. Lämna tomt för att "
"tillåta alla IP-adresser."

