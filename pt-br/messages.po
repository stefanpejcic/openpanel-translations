msgid ""
"Starts the application container and verifies it is running before "
"continuing."
msgstr ""
"Inicia o contêiner do aplicativo e verifica se está em execução antes de "
"continuar."

#: internal/web/templates/manager/app_install.html:545
msgid "Starting application container"
msgstr "Iniciando o contêiner do aplicativo"

#: internal/web/templates/manager/app_install.html:549
msgid ""
"Detects the installed webserver (Apache, Nginx, LiteSpeed or OpenResty) and "
"creates the reverse-proxy configuration for the domain."
msgstr ""
"Detecta o servidor web instalado (Apache, Nginx, LiteSpeed ou OpenResty) e "
"cria a configuração de proxy reverso para o domínio."

#: internal/web/templates/manager/app_install.html:551
msgid "Configuring reverse proxy"
msgstr "Configurando o proxy reverso"

#: internal/web/templates/manager/app_install.html:555
msgid ""
"Restarts the webserver container so the new reverse-proxy configuration is "
"applied."
msgstr ""
"Reinicia o contêiner do servidor web para que a nova configuração de proxy "
"reverso seja aplicada."

#: internal/web/templates/manager/app_install.html:557
msgid "Restarting webserver"
