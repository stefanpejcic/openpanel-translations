#: openpanel/internal/modules/account/notifications.go:33
msgid "New login"
msgstr "Novo login"

#: openpanel/internal/modules/account/notifications.go:33
msgid ""
"Get an email every time someone logs in to your account, with the IP "
"address, country and browser."
msgstr ""
"Receba um e-mail sempre que alguém fizer login na sua conta, com o endereço "
"IP, o país e o navegador."

#: openpanel/internal/modules/account/notifications.go:34
msgid "Also for IP addresses I logged in from before"
msgstr "Também para endereços IP de onde já fiz login antes"

#: openpanel/internal/modules/account/notifications.go:35
msgid "Email me if login alerts get turned off"
msgstr "Enviar e-mail se os alertas de login forem desativados"

#: openpanel/internal/modules/account/notifications.go:36
msgid "Password changed"
msgstr "Senha alterada"

#: openpanel/internal/modules/account/notifications.go:36
msgid "Get an email when the password for your account is changed."
msgstr "Receba um e-mail quando a senha da sua conta for alterada."

#: openpanel/internal/modules/account/notifications.go:37
#: openpanel/internal/modules/account/notifications.go:39
#: openpanel/internal/modules/account/notifications.go:41
#: openpanel/internal/modules/account/notifications.go:43
#: openpanel/internal/modules/account/notifications.go:45
msgid "Email me if this alert gets turned off"
msgstr "Enviar e-mail se este alerta for desativado"

#: openpanel/internal/modules/account/notifications.go:38
msgid "Contact email changed"
msgstr "E-mail de contato alterado"

#: openpanel/internal/modules/account/notifications.go:38
msgid ""
"Get an email when the contact email address for your account is changed."
msgstr ""
"Receba um e-mail quando o e-mail de contato da sua conta for alterado."

#: openpanel/internal/modules/account/notifications.go:40
msgid "Two-factor authentication changed"
msgstr "Autenticação de dois fatores alterada"

#: openpanel/internal/modules/account/notifications.go:40
msgid "Get an email when two-factor authentication is turned on or off."
msgstr ""
"Receba um e-mail quando a autenticação de dois fatores for ativada ou "
"desativada."

#: openpanel/internal/modules/account/notifications.go:42
msgid "Passkey added or removed"
msgstr "Passkey adicionada ou removida"

#: openpanel/internal/modules/account/notifications.go:42
msgid ""
"Get an email when a passkey is added to your account or removed from it."
msgstr ""
"Receba um e-mail quando uma passkey for adicionada ou removida da sua conta."

#: openpanel/internal/modules/account/notifications.go:44
msgid "API token created or revoked"
msgstr "Token de API criado ou revogado"

#: openpanel/internal/modules/account/notifications.go:44
msgid ""
"Get an email when an AI Assistant (MCP) token is created or revoked for your"
" account."
msgstr ""
"Receba um e-mail quando um token do Assistente de IA (MCP) for criado ou "
"revogado para sua conta."

#: openpanel/internal/modules/account/notifications.go:46
msgid "SSL certificate problem"
msgstr "Problema no certificado SSL"

#: openpanel/internal/modules/account/notifications.go:46
msgid ""
"Get an email when an SSL certificate fails to renew or is about to expire, "
"before visitors see a security warning."
msgstr ""
"Receba um e-mail quando um certificado SSL não renovar ou estiver prestes a "
"expirar, antes que os visitantes vejam um aviso de segurança."

#: openpanel/internal/modules/account/notifications.go:47
msgid "Malware found"
msgstr "Malware encontrado"

#: openpanel/internal/modules/account/notifications.go:47
msgid ""
"Get an email when the scheduled malware scan finds infected files and moves "
"them to quarantine."
msgstr ""
"Receba um e-mail quando a verificação agendada de malware encontrar arquivos"
" infectados e movê-los para a quarentena."

#: openpanel/internal/modules/account/notifications.go:48
msgid "Disk space running out"
msgstr "Espaço em disco acabando"

#: openpanel/internal/modules/account/notifications.go:48
msgid ""
"Get an email when your account uses 85% of its disk space or 95% of its "
"inodes."
msgstr ""
"Receba um e-mail quando sua conta usar 85% do espaço em disco ou 95% dos "
"inodes."

#: openpanel/internal/modules/account/notifications.go:49
msgid "Mailbox almost full"
msgstr "Caixa de correio quase cheia"

#: openpanel/internal/modules/account/notifications.go:49
msgid "Get an email when one of your email accounts uses 90% of its quota."
msgstr ""
"Receba um e-mail quando uma de suas contas de e-mail usar 90% da cota."

#: openpanel/internal/modules/account/notifications.go:50
msgid "Hourly email limit reached"
msgstr "Limite de e-mails por hora atingido"

#: openpanel/internal/modules/account/notifications.go:50
msgid ""
"Get an email when your account reaches its limit of emails sent per hour and"
" new emails are rejected."
msgstr ""
"Receba um e-mail quando sua conta atingir o limite de e-mails enviados por "
"hora e novos e-mails forem rejeitados."

#: openpanel/internal/modules/account/notifications.go:51
msgid "Service stopped"
msgstr "Serviço parado"

#: openpanel/internal/modules/account/notifications.go:51
msgid ""
"Get an email when a service like MySQL or PHP stopped or ran out of memory "
"and had to be restarted."
msgstr ""
"Receba um e-mail quando um serviço como MySQL ou PHP parar ou ficar sem "
"memória e precisar ser reiniciado."

#: openpanel/internal/modules/account/notifications.go:170
