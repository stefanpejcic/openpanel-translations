msgid "Startup command"
msgstr "Comandă de pornire"

#: internal/web/templates/manager/app_install.html:321
msgid ""
"If custom startup command is provided, it will be executed instead of the "
"default"
msgstr ""
"Dacă este furnizată o comandă personalizată de pornire, aceasta va fi "
"executată în locul celei implicite"

