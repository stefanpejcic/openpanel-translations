#: internal/web/templates/user/reset_password/request_email.html:10
msgid ""
"Enter your email address and we'll send you a link to reset your password."
msgstr ""
"Въведете вашия имейл адрес и ние ще ви изпратим линк за възстановяване на "
"паролата ви."

#: internal/web/templates/user/reset_password/request_email.html:18
msgid "Enter your email address"
msgstr "Въведете вашия е-поща адрес"

#: internal/web/templates/user/reset_password/request_email.html:21
msgid "Send Reset Link"
msgstr "Изпрати линк за нулиране"

#: internal/web/templates/user/reset_password/set_new_password.html:7
msgid "Reset Your Password"
msgstr "Нулирайте паролата си"

#: internal/web/templates/user/stats.html:18
msgid "View current resource usage for all websites and services."
msgstr ""
"Преглед на текущото използване на ресурсите за всички уеб-сайтове и услуги."

#: internal/web/templates/user/stats.html:21
msgid "View Usage History"
msgstr "Преглед на историята на използване"

#: internal/web/templates/user/stats.html:38
msgid "Current CPU usage:"
msgstr "Текущо използване на процесора:"

#: internal/web/templates/user/stats.html:39
msgid "Total CPU allocation:"
msgstr "Общо разпределение на процесора:"

#: internal/web/templates/user/stats.html:46
