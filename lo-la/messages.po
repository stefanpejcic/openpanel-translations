msgstr "ຂໍ້ຄວາມ (String), ຕົວຢ່າງ: job for mysql db dump"

#: openpanel/internal/web/templates/system/cronjobs.html:75
msgid "Optional."
msgstr "ບໍ່ຈຳເປັນ."

#: openpanel/internal/web/templates/system/cronjobs.html:77
#: openpanel/internal/web/templates/system/cronjobs.html:291
#: openpanel/internal/web/templates/system/cronjobs_new.html:95
msgid "No overlap"
msgstr "ບໍ່ໃຫ້ຊ້ອນທັບ"

