msgid "Command you want to run inside the container."
msgstr "ຄຳສັ່ງທີ່ທ່ານຕ້ອງການດຳເນີນຢູ່ພາຍໃນຄອນເທນເນີ."

#: openpanel/internal/web/templates/system/cronjobs.html:64
msgid "String, e.g. touch /tmp/example"
msgstr "ຂໍ້ຄວາມ (String), ຕົວຢ່າງ: touch /tmp/example"

#: openpanel/internal/web/templates/system/cronjobs.html:68
msgid "Name of the container you want to execute the command in."
msgstr "ຊື່ຂອງຄອນເທນເນີທີ່ທ່ານຕ້ອງການດຳເນີນຄຳສັ່ງນີ້."

#: openpanel/internal/web/templates/system/cronjobs.html:69
msgid "String, e.g. nginx-proxy"
msgstr "ຂໍ້ຄວາມ (String), ຕົວຢ່າງ: nginx-proxy"

#: openpanel/internal/web/templates/system/cronjobs.html:72
msgid "Comment"
msgstr "ຄຳອະທິບາຍ"

#: openpanel/internal/web/templates/system/cronjobs.html:73
msgid "Name/comment for the cron job"
msgstr "ຊື່/ຄຳອະທິບາຍສຳລັບວຽກ cron"

#: openpanel/internal/web/templates/system/cronjobs.html:74
