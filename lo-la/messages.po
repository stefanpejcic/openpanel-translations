msgstr ""
"ກູ້ຄືນ %(conf_file)s ເປັນການຕັ້ງຄ່າເລີ່ມຕົ້ນ ແລະ ໂຫຼດຄອນເທນເນີ "
"%(service_name)s ຄືນໃໝ່ສຳເລັດແລ້ວ."

#: internal/modules/webserverconf/handlers.go:136
msgid ""
"Changes saved to %(conf_file)s and %(service_name)s container reloaded "
"successfully."
msgstr ""
"ບັນທຶກການປ່ຽນແປງໃນ %(conf_file)s ແລະ ໂຫຼດຄອນເທນເນີ %(service_name)s "
"ຄືນໃໝ່ສຳເລັດແລ້ວ."

#: internal/modules/webserverconf/handlers.go:144
