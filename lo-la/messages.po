#: openpanel/internal/web/templates/manager/wp/single.html:1304
msgid "Saving update preferences... Please wait."
msgstr "ກຳລັງບັນທຶກການຕັ້ງຄ່າການອັບເດດ... ກະລຸນາລໍຖ້າ."

#: openpanel/internal/web/templates/manager/wp/single.html:1338
msgid "Saving general settings... Please wait."
msgstr "ກຳລັງບັນທຶກການຕັ້ງຄ່າທົ່ວໄປ... ກະລຸນາລໍຖ້າ."

#: openpanel/internal/web/templates/manager/wp/single.html:1384
msgid "Error fetching debug info. Refresh the page."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການດຶງຂໍ້ມູນດີບັກ. ກະລຸນາໂຫຼດໜ້າຄືນໃໝ່."

#: openpanel/internal/web/templates/manager/wp/single.html:1399
msgid ""
"The options below allow you to manage the native WordPress debugging tools, "
"enabling and disabling these tools in the wp-config.php file. It is not "
"recommended to use these options on production websites since they are meant"
" for development and test installations. Refer to"
msgstr ""
"ຕົວເລືອກລຸ່ມນີ້ຊ່ວຍໃຫ້ທ່ານຈັດການເຄື່ອງມືດີບັກຂອງ WordPress ໂດຍການເປີດ ຫຼື "
"ປິດການໃຊ້ງານໃນໄຟລ໌ wp-config.php. "
"ບໍ່ແນະນຳໃຫ້ໃຊ້ຕົວເລືອກເຫຼົ່ານີ້ໃນເວັບໄຊທ໌ທີ່ໃຊ້ງານຈິງ "
"ເພາະມັນມີໄວ້ສຳລັບການພັດທະນາ ແລະ ທົດສອບເທົ່ານັ້ນ. ອ້າງອີງຈາກ"

#: openpanel/internal/web/templates/manager/wp/single.html:1399
msgid "Debugging in WordPress"
msgstr "ການດີບັກໃນ WordPress"

#: openpanel/internal/web/templates/manager/wp/single.html:1399
msgid "article for more information on these options."
msgstr "ບົດຄວາມສຳລັບຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບຕົວເລືອກເຫຼົ່ານີ້."

#: openpanel/internal/web/templates/manager/wp/single.html:1410
#: openpanel/internal/web/templates/manager/wp/single.html:1416
msgid "WP_DEBUG"
msgstr "WP_DEBUG"

#: openpanel/internal/web/templates/manager/wp/single.html:1411
msgid "WordPress debug mode."
msgstr "ໂໝດດີບັກຂອງ WordPress."

#: openpanel/internal/web/templates/manager/wp/single.html:1418
msgid "Enable WP_DEBUG mode"
msgstr "ເປີດໃຊ້ໂໝດ WP_DEBUG"

#: openpanel/internal/web/templates/manager/wp/single.html:1429
#: openpanel/internal/web/templates/manager/wp/single.html:1435
msgid "WP_DEBUG_LOG"
msgstr "WP_DEBUG_LOG"

#: openpanel/internal/web/templates/manager/wp/single.html:1430
msgid "Save all errors to the debug.log file inside the wp-content directory."
msgstr "ບັນທຶກຂໍ້ຜິດພາດທັງໝົດລົງໃນໄຟລ໌ debug.log ພາຍໃນໄດເຣັກທໍຣີ wp-content."

#: openpanel/internal/web/templates/manager/wp/single.html:1437
msgid "Enable WP_DEBUG_LOG"
msgstr "ເປີດໃຊ້ WP_DEBUG_LOG"

#: openpanel/internal/web/templates/manager/wp/single.html:1448
#: openpanel/internal/web/templates/manager/wp/single.html:1454
msgid "WP_DEBUG_DISPLAY"
msgstr "WP_DEBUG_DISPLAY"

#: openpanel/internal/web/templates/manager/wp/single.html:1449
msgid "Show debug messages inside the HTML pages"
msgstr "ສະແດງຂໍ້ຄວາມດີບັກພາຍໃນໜ້າ HTML"

#: openpanel/internal/web/templates/manager/wp/single.html:1456
msgid "Enable WP_DEBUG_DISPLAY"
msgstr "ເປີດໃຊ້ WP_DEBUG_DISPLAY"

#: openpanel/internal/web/templates/manager/wp/single.html:1467
#: openpanel/internal/web/templates/manager/wp/single.html:1473
msgid "SCRIPT_DEBUG"
msgstr "SCRIPT_DEBUG"

#: openpanel/internal/web/templates/manager/wp/single.html:1468
msgid ""
"Force WordPress to use the non-minified versions of core CSS and JavaScript "
"files. This is useful when you are testing changes made to .js and .css "
"files."
msgstr ""
"ບັງຄັບໃຫ້ WordPress ໃຊ້ໄຟລ໌ CSS ແລະ JavaScript ຫຼັກໃນເວີຊັນທີ່ບໍ່ໄດ້ບີບອັດ. "
"ນີ້ມີປະໂຫຍດໃນເວລາທີ່ທ່ານກໍາລັງທົດສອບການປ່ຽນແປງທີ່ເກີດຂຶ້ນກັບໄຟລ໌ .js ແລະ "
".css."

#: openpanel/internal/web/templates/manager/wp/single.html:1475
msgid "Enable SCRIPT_DEBUG"
msgstr "ເປີດໃຊ້ SCRIPT_DEBUG"

#: openpanel/internal/web/templates/manager/wp/single.html:1486
#: openpanel/internal/web/templates/manager/wp/single.html:1492
msgid "SAVEQUERIES"
msgstr "SAVEQUERIES"

#: openpanel/internal/web/templates/manager/wp/single.html:1487
msgid ""
"Save database queries to an array that can be displayed to help analyze "
"them."
msgstr ""
"ບັນທຶກການສອບຖາມຖານຂໍ້ມູນ (queries) ໄວ້ໃນອາເຣ (array) "
"ທີ່ສາມາດສະແດງອອກມາເພື່ອຊ່ວຍໃນການວິເຄາະ."

#: openpanel/internal/web/templates/manager/wp/single.html:1494
msgid "Enable SAVEQUERIES"
msgstr "ເປີດໃຊ້ SAVEQUERIES"

#: openpanel/internal/web/templates/manager/wp/single.html:1504
msgid "Save Debugging"
msgstr "ບັນທຶກການດີບັກ (Debugging)"

#: openpanel/internal/web/templates/manager/wp/single.html:1512
msgid "Saving debugging options... Please wait."
msgstr "ກຳລັງບັນທຶກຕົວເລືອກການດີບັກ... ກະລຸນາລໍຖ້າ."

#: openpanel/internal/web/templates/manager/wp/single.html:1538
msgid "Clone a WordPress instance with configured themes and plugins."
msgstr "ໂຄລນອິນສະແຕນ WordPress ພ້ອມທີມ ແລະ ປລັກອິນທີ່ຕັ້ງຄ່າໄວ້."

#: openpanel/internal/web/templates/manager/wp/single.html:1730
#: openpanel/internal/web/templates/manager/wp/single.html:1740
msgid "Remove the"
msgstr "ເອົາ"

#: openpanel/internal/web/templates/manager/wp/single.html:1730
msgid "website from WP Manager."
msgstr "ເວັບໄຊທ໌ອອກຈາກ WP Manager."

#: openpanel/internal/web/templates/manager/wp/single.html:1737
msgid "Detach WordPress"
msgstr "ແຍກ WordPress ອອກ"

#: openpanel/internal/web/templates/manager/wp/single.html:1740
msgid "website from this manager without actually deleting any files."
msgstr "ເວັບໄຊທ໌ອອກຈາກຕົວຈັດການນີ້ໂດຍບໍ່ໄດ້ລົບໄຟລ໌ແທ້."

#: openpanel/internal/web/templates/manager/wp/single.html:1741
msgid "All website data such as files, crons and database remains."
msgstr "ຂໍ້ມູນເວັບໄຊທ໌ທັງໝົດ ເຊັ່ນ ໄຟລ໌, cron ແລະ ຖານຂໍ້ມູນຍັງຄົງຢູ່."

#: openpanel/internal/web/templates/manager/wp/single.html:1762
msgid "Permanently delete WordPress files & database."
msgstr "ລຶບໄຟລ໌ ແລະ ຖານຂໍ້ມູນຂອງ WordPress ຖາວອນ."

#: openpanel/internal/web/templates/manager/wp/single.html:1769
msgid "Uninstall WordPress"
msgstr "ຖອນການຕິດຕັ້ງ WordPress"

#: openpanel/internal/web/templates/manager/wp/single.html:1772
msgid "Delete the"
msgstr "ລຶບ"

#: openpanel/internal/web/templates/manager/wp/single.html:1772
msgid "website and all its files and database."
msgstr "ເວັບໄຊທ໌ພ້ອມທັງໄຟລ໌ ແລະ ຖານຂໍ້ມູນທັງໝົດ."

#: openpanel/internal/web/templates/manager/wp/single.html:1773
msgid ""
"All WordPress data will be permanently deleted. There is no coming back "
"after you press delete."
msgstr ""
"ຂໍ້ມູນ WordPress ທັງໝົດຈະຖືກລົບຖາວອນ. ທ່ານຈະບໍ່ສາມາດກູ້ຄືນໄດ້ຫຼັງຈາກກົດລົບ."

#: openpanel/internal/web/templates/manager/wp/single.html:1776
msgid "Confirm Uninstall"
msgstr "ຢືນຢັນການຖອນການຕິດຕັ້ງ"

