#: internal/web/templates/user/reset_password/link_is_sent.html:11
msgid "Password reset link sent"
msgstr ""

#: internal/modules/account/forgotpassword.go:220
msgid "Password Reset Requested"
msgstr "ມີການຮ້ອງຂໍຕັ້ງລະຫັດຜ່ານໃໝ່"

#: internal/modules/account/forgotpassword.go:230
msgid "OpenPanel [%(domain)s] - Password Reset Requested"
msgstr "OpenPanel [%(domain)s] - ຮ້ອງຂໍການຣີເຊັດລະຫັດຜ່ານ"

#: internal/modules/account/forgotpassword.go:348
msgid "Reset link is invalid"
msgstr "ລິ້ງຕັ້ງລະຫັດຜ່ານໃໝ່ບໍ່ຖືກຕ້ອງ"

#: internal/modules/account/forgotpassword.go:350
msgid "Reset link has expired"
msgstr "ລິ້ງຕັ້ງລະຫັດຜ່ານໃໝ່ໝົດອາຍຸແລ້ວ"

#: internal/modules/account/forgotpassword.go:362
msgid "Link has already been used or is invalid"
msgstr "ລິ້ງຖືກນຳໃຊ້ໄປແລ້ວ ຫຼື ບໍ່ຖືກຕ້ອງ"

#: internal/modules/account/forgotpassword.go:377
msgid "Passwords do not match"
msgstr "ລະຫັດຜ່ານບໍ່ກົງກັນ"

#: internal/modules/account/forgotpassword.go:402
msgid "password changed using email confirmation"
msgstr "ປ່ຽນລະຫັດຜ່ານໂດຍໃຊ້ການຢືນຢັນທາງອີເມວແລ້ວ"

#: internal/modules/account/forgotpassword.go:407
msgid "Your password has been reset. Please log in."
msgstr "ລະຫັດຜ່ານຂອງທ່ານຖືກຕັ້ງໃໝ່ແລ້ວ. ກະລຸນາເຂົ້າສູ່ລະບົບ."

#: internal/modules/account/forgotpassword.go:414
#: internal/web/templates/user/email_template.html:54
msgid "Reset password"
msgstr ""

#: internal/modules/account/handlers_passkeys.go:211
