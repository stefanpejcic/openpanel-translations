msgid "Folder"
msgstr "ໂຟນເດີ"

#: openpanel/internal/web/templates/domains/delete.html:56
msgid "and all associated data will be kept."
msgstr "ແລະ ຂໍ້ມູນທີ່ກ່ຽວຂ້ອງທັງໝົດຈະຖືກເກັບໄວ້."

