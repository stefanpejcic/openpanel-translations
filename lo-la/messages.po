msgstr "ສະແດງຂໍ້ຄວາມດີບັກພາຍໃນໜ້າ HTML"

#: internal/web/templates/manager/wp/single.html:1536
msgid "Enable WP_DEBUG_DISPLAY"
msgstr "ເປີດໃຊ້ WP_DEBUG_DISPLAY"

