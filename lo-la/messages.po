#: internal/web/templates/manager/wp/single.html:1553
msgid "SCRIPT_DEBUG"
msgstr "SCRIPT_DEBUG"

#: internal/web/templates/manager/wp/single.html:1548
msgid ""
"Force WordPress to use the non-minified versions of core CSS and JavaScript "
"files. This is useful when you are testing changes made to .js and .css "
"files."
