msgid "Login"
msgstr "ເຂົ້າສູ່ລະບົບ"

#: openpanel/internal/modules/account/login.go:210
#: openpanel/internal/modules/account/login.go:216
msgid "Invalid 2FA code. Please try again."
msgstr "ລະຫັດ 2FA ບໍ່ຖືກຕ້ອງ. ກະລຸນາລອງໃໝ່."

#: openpanel/internal/modules/account/login.go:364
msgid "Autologin failed: Invalid username."
msgstr "ການເຂົ້າສູ່ລະບົບອັດຕະໂນມັດລົ້ມເຫລວ: ຊື່ຜູ້ໃຊ້ບໍ່ຖືກຕ້ອງ."

#: openpanel/internal/modules/account/login.go:372
msgid "Error reading token from user files."
msgstr "ເກີດຂໍ້ຜິດພາດໃນການອ່ານໂທເຄັນຈາກໄຟລ໌ຂອງຜູ້ໃຊ້."

#: openpanel/internal/modules/account/login.go:379
msgid "Autologin failed: Invalid or expired token."
msgstr "ການເຂົ້າສູ່ລະບົບອັດຕະໂນມັດລົ້ມເຫລວ: ໂທເຄັນບໍ່ຖືກຕ້ອງ ຫຼື ໝົດອາຍຸແລ້ວ."

#: openpanel/internal/modules/account/login.go:387
msgid "Autologin failed: User does not exist."
msgstr "ການເຂົ້າສູ່ລະບົບອັດຕະໂນມັດລົ້ມເຫລວ: ບໍ່ມີຜູ້ໃຊ້ນີ້ຢູ່."

#: openpanel/internal/modules/account/passwords.go:48
msgid "Your account is suspended. Please contact support."
msgstr "ບັນຊີຂອງທ່ານຖືກລະງັບ. ກະລຸນາຕິດຕໍ່ຝ່າຍຊ່ວຍເຫຼືອ."

#: openpanel/internal/modules/account/passwords.go:50
msgid "Unrecognized account. Please check username."
msgstr "ບໍ່ຮູ້ຈັກບັນຊີນີ້. ກະລຸນາກວດສອບຊື່ຜູ້ໃຊ້."

#: openpanel/internal/modules/account/passwords.go:54
msgid "Unable to connect to database."
msgstr "ບໍ່ສາມາດເຊື່ອມຕໍ່ຖານຂໍ້ມູນໄດ້."

#: openpanel/internal/modules/account/passwords.go:77
msgid "Invalid password. Please try again."
msgstr "ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ. ກະລຸນາລອງໃໝ່."

#: openpanel/internal/modules/account/ratelimit.go:97
msgid "Too many failed login attempts. Please try again later."
msgstr "ພະຍາຍາມເຂົ້າສູ່ລະບົບຜິດພາດຫຼາຍເທື່ອເກີນໄປ. ກະລຸນາລອງໃໝ່ພາຍຫຼັງ."

#: openpanel/internal/modules/appinstall/java.go:25
#: openpanel/internal/web/templates/manager/autoinstaller.html:731
#: openpanel/internal/web/templates/manager/python_node_apps.html:168
msgid "Java"
msgstr "Java"

#: openpanel/internal/modules/appinstall/java.go:26
msgid "Run Maven install before starting the app"
msgstr "ແລ່ນ Maven install ກ່ອນເລີ່ມແອັບພລິເຄຊັນ"

#: openpanel/internal/modules/appinstall/java.go:27
msgid ""
"When enabled, this option will first run mvn install using the pom.xml file,"
" then launch the application. If the application is already built, you can "
"skip this option."
msgstr ""
"ເມື່ອເປີດໃຊ້ ຕົວເລືອກນີ້ຈະແລ່ນ mvn install ໂດຍໃຊ້ໄຟລ໌ pom.xml ກ່ອນ "
"ຈາກນັ້ນຈຶ່ງເປີດແອັບພລິເຄຊັນ. ຖ້າແອັບພລິເຄຊັນຖືກສ້າງໄວ້ແລ້ວ "
"ທ່ານສາມາດຂ້າມຕົວເລືອກນີ້ໄດ້."

#: openpanel/internal/modules/appinstall/java.go:31
msgid "Install Java Application"
msgstr "ຕິດຕັ້ງແອັບພລິເຄຊັນ Java"

#: openpanel/internal/modules/appinstall/nodejs.go:15
#: openpanel/internal/web/templates/manager/python_node_apps.html:165
msgid "NodeJS"
msgstr "NodeJS"

#: openpanel/internal/modules/appinstall/nodejs.go:16
