"Token oluşturulamadı: veritabanı kullanılamıyor. Lütfen tekrar deneyin."

#: internal/modules/account/mcp.go:86
msgid "Token \"%(name)s\" created. Copy it below - it will not be shown again."
msgstr ""
"\"%(name)s\" token'ı oluşturuldu. Aşağıdan kopyalayın - tekrar "
"gösterilmeyecek."

#: internal/modules/account/mcp.go:114
msgid "Token revoked."
msgstr "Token iptal edildi."

#: internal/modules/account/mcp.go:116
msgid "Token not found."
msgstr "Token bulunamadı."

