msgstr "Weryfikacja captcha nie powiodła się. Spróbuj ponownie."

#: internal/modules/account/login.go:240
msgid ""
"Your login session expired. Please enter your username and password again."
msgstr ""
"Twoja sesja logowania wygasła. Wprowadź ponownie nazwę użytkownika i hasło."

#: internal/modules/account/login.go:253 internal/modules/account/login.go:259
msgid "Invalid 2FA code. Please try again."
msgstr "Nieprawidłowy kod 2FA. Spróbuj ponownie."

#: internal/modules/account/login.go:415
msgid "Autologin failed: Invalid username."
msgstr ""
"Automatyczne logowanie nie powiodło się: Nieprawidłowa nazwa użytkownika."

#: internal/modules/account/login.go:423
msgid "Error reading token from user files."
msgstr "Błąd odczytu tokena z plików użytkownika."

#: internal/modules/account/login.go:430
msgid "Autologin failed: Invalid or expired token."
msgstr ""
"Automatyczne logowanie nie powiodło się: Nieprawidłowy lub wygasły token."

#: internal/modules/account/login.go:438
msgid "Autologin failed: User does not exist."
msgstr "Automatyczne logowanie nie powiodło się: Użytkownik nie istnieje."

#: internal/modules/account/mcp.go:64
msgid "Could not create token: database is unavailable. Please try again."
msgstr ""
"Nie udało się utworzyć tokenu: baza danych jest niedostępna. Spróbuj "
"ponownie."

#: internal/modules/account/mcp.go:86
msgid "Token \"%(name)s\" created. Copy it below - it will not be shown again."
msgstr ""
"Token \"%(name)s\" został utworzony. Skopiuj go poniżej - nie zostanie "
"ponownie wyświetlony."

#: internal/modules/account/mcp.go:114
msgid "Token revoked."
msgstr "Token unieważniony."

#: internal/modules/account/mcp.go:116
msgid "Token not found."
msgstr "Nie znaleziono tokenu."

