#: internal/web/templates/dashboard/onboarding.html:246
msgid ""
"Filters malicious requests to your websites before they reach your "
"applications."
msgstr "Filtruje złośliwe żądania do Twoich stron, zanim dotrą do aplikacji."

#: internal/web/templates/dashboard/onboarding.html:256
msgid "Deny specific IPs or CIDR ranges access to your websites."
msgstr ""
"Odmawiaj dostępu do swoich stron określonym adresom IP lub zakresom CIDR."

#: internal/web/templates/dashboard/onboarding.html:266
msgid ""
"Use an authenticator app (Google Authenticator, Authy, etc.) to generate "
"one-time codes."
msgstr ""
"Użyj aplikacji uwierzytelniającej (Google Authenticator, Authy itp.) do "
"generowania jednorazowych kodów."

