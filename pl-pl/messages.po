#: internal/web/templates/dashboard/onboarding.html:346
msgid "Passkey"
msgstr "Klucz dostępu (Passkey)"

#: internal/web/templates/dashboard/onboarding.html:276
msgid ""
"Sign in with your device's fingerprint, face recognition, or a security key "
"- no password needed."
msgstr ""
"Zaloguj się za pomocą odcisku palca, rozpoznawania twarzy lub klucza "
"bezpieczeństwa - bez potrzeby podawania hasła."

#: internal/web/templates/dashboard/onboarding.html:313
msgid ""
"Enter one IP address or CIDR range per line. Leave empty to allow all IPs."
msgstr ""
"Wpisz jeden adres IP lub zakres CIDR w każdej linii. Pozostaw puste, aby "
"zezwolić na wszystkie adresy IP."

