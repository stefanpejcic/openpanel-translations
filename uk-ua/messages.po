msgid "TinyFileManager:"
msgstr "TinyFileManager:"

#: openpanel/internal/web/templates/manager/tinyfilemanager_app.html:259
msgid ""
"TinyFileManager is ready to use - log in with the admin credentials set at "
"install time."
msgstr ""
