#: internal/modules/dashboard/sections.go:185
#: internal/modules/dashboard/sections.go:315
#: internal/modules/summary/register.go:129 internal/web/sidebar.go:358
#: internal/web/templates/system/summary.html:20
#: internal/web/templates/system/summary.html:23
msgid "Daily summary"
msgstr "Щоденний підсумок"

#: internal/modules/account/notifications.go:55
msgid ""
"Get one email each morning with what needs your attention on your account "
"and websites, and the day's traffic, logins and changes."
msgstr ""
"Отримуйте щоранку лист про те, що потребує вашої уваги в акаунті та на "
"сайтах, а також про трафік, входи та зміни за день."

#: internal/modules/account/notifications.go:56
msgid "Daily error report"
msgstr "Щоденний звіт про помилки"

#: internal/modules/account/notifications.go:56
msgid ""
"Get one email a day with the errors found in your websites' logs in the last"
" 24 hours, the same ones shown on the Error Logs page."
msgstr ""
"Отримуйте раз на день лист із помилками з журналів ваших сайтів за останні "
"24 години, тими самими, що на сторінці Журнали помилок."

