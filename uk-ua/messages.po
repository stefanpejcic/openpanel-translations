#: internal/modules/account/login.go:195
#: internal/modules/account/passwords.go:42
msgid "Unrecognized account. Please check username."
msgstr "Невизнаний обліковий запис. Будь ласка, перевірте ім'я користувача."

#: internal/modules/account/login.go:195
#: internal/modules/account/passwords.go:69
msgid "Invalid password. Please try again."
msgstr "Неправильний пароль. Будь ласка, спробуйте знову."

#: internal/modules/account/login.go:214
msgid "Captcha verification failed. Please try again."
msgstr "Перевірку captcha не пройдено. Спробуйте ще раз."

#: internal/modules/account/login.go:224
#: internal/modules/account/passwords.go:40
msgid "Your account is suspended. Please contact support."
msgstr ""
"Ваш обліковий запис призупинено. Будь ласка, зверніться до служби підтримки."

#: internal/modules/account/login.go:250
msgid ""
"Your login session expired. Please enter your username and password again."
msgstr ""
"Термін дії сеансу входу минув. Введіть ім'я користувача та пароль ще раз."

#: internal/modules/account/login.go:263 internal/modules/account/login.go:269
msgid "Invalid 2FA code. Please try again."
msgstr "Недійсний код 2FA. Будь ласка, спробуйте знову."

#: internal/modules/account/login.go:426
msgid "Autologin failed: Invalid username."
msgstr "Помилка автоматичного входу: недійсне ім'я користувача."

#: internal/modules/account/login.go:434
msgid "Error reading token from user files."
msgstr "Помилка читання токена з файлів користувача."

#: internal/modules/account/login.go:441
msgid "Autologin failed: Invalid or expired token."
msgstr "Помилка автоматичного входу: недійсний або прострочений токен."

#: internal/modules/account/login.go:449
msgid "Autologin failed: User does not exist."
msgstr "Помилка автоматичного входу: користувач не існує."

#: internal/modules/account/mcp.go:64
msgid "Could not create token: database is unavailable. Please try again."
msgstr "Не вдалося створити токен: база даних недоступна. Спробуйте ще раз."

#: internal/modules/account/mcp.go:86
msgid "Token \"%(name)s\" created. Copy it below - it will not be shown again."
msgstr ""
"Токен \"%(name)s\" створено. Скопіюйте його нижче — він більше не буде "
"показаний."

#: internal/modules/account/mcp.go:114
msgid "Token revoked."
msgstr "Токен відкликано."

#: internal/modules/account/mcp.go:116
msgid "Token not found."
msgstr "Токен не знайдено."

#: internal/modules/account/mcp.go:140
#: internal/web/templates/user/mcp.html:136
msgid "Revoke"
msgstr "Відкликати"

#: internal/modules/account/mcp.go:140
msgid ""
"Revoke the selected tokens? MCP clients using them stop working immediately."
msgstr ""
"Відкликати вибрані токени? MCP-клієнти, що їх використовують, одразу "
"перестануть працювати."

#: internal/modules/account/notifications.go:34
msgid "New login"
msgstr "Новий вхід"

#: internal/modules/account/notifications.go:34
msgid ""
"Get an email every time someone logs in to your account, with the IP "
"address, country and browser."
msgstr ""
"Отримуйте лист щоразу, коли хтось входить у ваш акаунт, з IP-адресою, "
"країною та браузером."

#: internal/modules/account/notifications.go:35
msgid "Also for IP addresses I logged in from before"
msgstr "Також для IP-адрес, з яких я входив раніше"

#: internal/modules/account/notifications.go:36
msgid "Email me if login alerts get turned off"
msgstr "Надсилати мені лист, якщо сповіщення про вхід вимкнено"

#: internal/modules/account/notifications.go:37
msgid "Password changed"
msgstr "Пароль змінено"

#: internal/modules/account/notifications.go:37
msgid "Get an email when the password for your account is changed."
msgstr "Отримуйте лист, коли змінюється пароль вашого акаунта."

#: internal/modules/account/notifications.go:38
#: internal/modules/account/notifications.go:40
#: internal/modules/account/notifications.go:42
#: internal/modules/account/notifications.go:44
#: internal/modules/account/notifications.go:46
msgid "Email me if this alert gets turned off"
msgstr "Надсилати мені лист, якщо це сповіщення вимкнено"

#: internal/modules/account/notifications.go:39
msgid "Contact email changed"
msgstr "Контактну e-mail адресу змінено"

#: internal/modules/account/notifications.go:39
msgid ""
"Get an email when the contact email address for your account is changed."
msgstr ""
"Отримуйте лист, коли змінюється контактна адреса e-mail вашого акаунта."

#: internal/modules/account/notifications.go:41
msgid "Two-factor authentication changed"
msgstr "Двофакторну автентифікацію змінено"

#: internal/modules/account/notifications.go:41
msgid "Get an email when two-factor authentication is turned on or off."
msgstr ""
"Отримуйте лист, коли двофакторну автентифікацію вмикають або вимикають."

#: internal/modules/account/notifications.go:43
msgid "Passkey added or removed"
msgstr "Passkey додано або видалено"

#: internal/modules/account/notifications.go:43
msgid ""
"Get an email when a passkey is added to your account or removed from it."
msgstr ""
"Отримуйте лист, коли passkey додають до акаунта або видаляють з нього."

#: internal/modules/account/notifications.go:45
msgid "API token created or revoked"
msgstr "API-токен створено або відкликано"

#: internal/modules/account/notifications.go:45
msgid ""
"Get an email when an AI Assistant (MCP) token is created or revoked for your"
" account."
msgstr ""
"Отримуйте лист, коли для вашого акаунта створюють або відкликають токен AI-"
"асистента (MCP)."

#: internal/modules/account/notifications.go:47
msgid "SSL certificate problem"
msgstr "Проблема з SSL-сертифікатом"

#: internal/modules/account/notifications.go:47
msgid ""
"Get an email when an SSL certificate fails to renew or is about to expire, "
"before visitors see a security warning."
msgstr ""
"Отримуйте лист, коли SSL-сертифікат не вдалося поновити або термін його дії "
"скоро спливе, ще до того, як відвідувачі побачать попередження безпеки."

#: internal/modules/account/notifications.go:48
msgid "Malware found"
msgstr "Виявлено шкідливе ПЗ"

#: internal/modules/account/notifications.go:48
msgid "Get an email when a malware scan finds infected files on your account."
msgstr ""
"Отримуйте лист, коли перевірка на шкідливе ПЗ знаходить заражені файли у "
"вашому акаунті."

#: internal/modules/account/notifications.go:49
msgid "Vulnerable WordPress site"
msgstr "Вразливий сайт WordPress"

#: internal/modules/account/notifications.go:49
msgid ""
"Get an email when WordPress, a plugin or a theme on one of your websites has"
" a known security vulnerability."
msgstr ""
"Отримуйте лист, коли WordPress, плагін або тема на одному з ваших сайтів має"
" відому вразливість."

#: internal/modules/account/notifications.go:50
msgid "Disk space running out"
msgstr "Закінчується місце на диску"

#: internal/modules/account/notifications.go:50
msgid ""
"Get an email when your account uses 85% of its disk space or 95% of its "
"inodes."
msgstr ""
"Отримуйте лист, коли ваш акаунт використовує 85% дискового простору або 95% "
"inode."

#: internal/modules/account/notifications.go:51
msgid "Mailbox almost full"
msgstr "Поштова скринька майже заповнена"

#: internal/modules/account/notifications.go:51
msgid "Get an email when one of your email accounts uses 90% of its quota."
msgstr ""
"Отримуйте лист, коли одна з ваших поштових скриньок використовує 90% квоти."

#: internal/modules/account/notifications.go:52
msgid "Hourly email limit reached"
msgstr "Досягнуто погодинного ліміту листів"

#: internal/modules/account/notifications.go:52
msgid ""
"Get an email when your account reaches its limit of emails sent per hour and"
" new emails are rejected."
msgstr ""
"Отримуйте лист, коли ваш акаунт досягає погодинного ліміту надісланих листів"
" і нові листи відхиляються."

#: internal/modules/account/notifications.go:53
msgid "Service stopped"
msgstr "Службу зупинено"

#: internal/modules/account/notifications.go:53
msgid ""
"Get an email when a service like MySQL or PHP stopped or ran out of memory "
"and had to be restarted."
msgstr ""
"Отримуйте лист, коли служба на кшталт MySQL або PHP зупинилася чи їй "
"забракло пам'яті й її довелося перезапустити."

#: internal/modules/account/notifications.go:54
msgid "Visitors blocked by rate limit"
msgstr "Відвідувачі, заблоковані лімітом запитів"

#: internal/modules/account/notifications.go:54
msgid ""
"Get an email when visitors to one of your domains were blocked for sending "
"too many requests per minute."
msgstr ""
"Отримуйте лист, коли відвідувачів одного з ваших доменів було заблоковано за"
" надто велику кількість запитів на хвилину."

