msgstr ""
"Controleert of de MySQL/MariaDB-container draait en maakt daarna de database"
" en gebruiker aan en kent alle rechten toe."

#: internal/web/templates/manager/wp/install.html:301
msgid "Creating database & MySQL user"
msgstr "Database & MySQL-gebruiker aanmaken"

#: internal/web/templates/manager/wp/install.html:305
