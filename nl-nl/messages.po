msgstr "Er is een fout opgetreden bij het verifiëren van de checksums."

#: internal/web/templates/manager/wp/single.html:773
msgid "Checking integrity for all WordPress plugins... Please wait."
msgstr ""
"Integriteit van alle WordPress-plug-ins wordt gecontroleerd... Even geduld."

#: internal/web/templates/manager/wp/single.html:800
msgid "An error occurred while verifying plugins checksums."
msgstr ""
"Er is een fout opgetreden bij het verifiëren van de checksums van plug-ins."

#: internal/web/templates/manager/wp/single.html:822
