msgstr ""
"Startet den Anwendungscontainer und überprüft, ob er läuft, bevor "
"fortgefahren wird."

#: internal/web/templates/manager/app_install.html:460
msgid "Starting application container"
msgstr "Anwendungscontainer wird gestartet"

