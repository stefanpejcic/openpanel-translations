msgstr "Postavlja uređenu strukturu permalink-ova i slogan sajta."

#: internal/web/templates/manager/wp/install.html:313
msgid "Configuring permalinks & site settings"
msgstr "Podešavanje permalink-ova i podešavanja sajta"

