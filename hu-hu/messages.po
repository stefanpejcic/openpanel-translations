#: internal/modules/account/login.go:140
#: internal/web/templates/manager/dokuwiki_app.html:101
msgid "Login"
msgstr "Bejelentkezés"

#: internal/modules/account/login.go:206
msgid "Captcha verification failed. Please try again."
msgstr "A captcha-ellenőrzés sikertelen. Kérjük, próbálja újra."

#: internal/modules/account/login.go:240
msgid ""
"Your login session expired. Please enter your username and password again."
msgstr ""
"A bejelentkezési munkamenet lejárt. Kérjük, adja meg újra a felhasználónevét"
" és jelszavát."

#: internal/modules/account/login.go:253 internal/modules/account/login.go:259
msgid "Invalid 2FA code. Please try again."
msgstr "Érvénytelen 2FA kód. Kérjük, próbálja újra."

#: internal/modules/account/login.go:416
msgid "Autologin failed: Invalid username."
msgstr "Az automatikus bejelentkezés sikertelen: érvénytelen felhasználónév."

#: internal/modules/account/login.go:424
msgid "Error reading token from user files."
msgstr "Hiba a token beolvasása során a felhasználói fájlokból."

#: internal/modules/account/login.go:431
msgid "Autologin failed: Invalid or expired token."
msgstr ""
"Az automatikus bejelentkezés sikertelen: Érvénytelen vagy lejárt token."

#: internal/modules/account/login.go:439
msgid "Autologin failed: User does not exist."
msgstr "Az automatikus bejelentkezés sikertelen: A felhasználó nem létezik."

#: internal/modules/account/mcp.go:64
msgid "Could not create token: database is unavailable. Please try again."
msgstr ""
"Nem sikerült létrehozni a tokent: az adatbázis nem érhető el. Kérjük, "
"próbálja újra."

#: internal/modules/account/mcp.go:86
msgid "Token \"%(name)s\" created. Copy it below - it will not be shown again."
msgstr ""
"A(z) \"%(name)s\" token létrehozva. Másolja ki alább – többé nem jelenik "
"meg."

#: internal/modules/account/mcp.go:114
msgid "Token revoked."
msgstr "Token visszavonva."

#: internal/modules/account/mcp.go:116
msgid "Token not found."
msgstr "Token nem található."

#: internal/modules/account/mcp.go:140 internal/web/templates/user/mcp.html:70
msgid "Revoke"
msgstr "Visszavonás"

#: internal/modules/account/mcp.go:140
msgid ""
"Revoke the selected tokens? MCP clients using them stop working immediately."
msgstr ""
"Visszavonja a kiválasztott tokeneket? Az ezeket használó MCP-kliensek "
"azonnal leállnak."

#: internal/modules/account/notifications.go:34
msgid "New login"
msgstr "Új bejelentkezés"

#: internal/modules/account/notifications.go:34
msgid ""
"Get an email every time someone logs in to your account, with the IP "
"address, country and browser."
msgstr ""
"Kapjon e-mailt minden alkalommal, amikor valaki bejelentkezik a fiókjába, az"
" IP-címmel, országgal és böngészővel."

#: internal/modules/account/notifications.go:35
msgid "Also for IP addresses I logged in from before"
msgstr "Azokra az IP-címekre is, amelyekről korábban már bejelentkeztem"

#: internal/modules/account/notifications.go:36
msgid "Email me if login alerts get turned off"
msgstr "Küldjön e-mailt, ha a bejelentkezési riasztásokat kikapcsolják"

#: internal/modules/account/notifications.go:37
msgid "Password changed"
msgstr "Jelszó megváltozott"

#: internal/modules/account/notifications.go:37
msgid "Get an email when the password for your account is changed."
msgstr "Kapjon e-mailt, ha megváltozik a fiókja jelszava."

#: internal/modules/account/notifications.go:38
#: internal/modules/account/notifications.go:40
#: internal/modules/account/notifications.go:42
#: internal/modules/account/notifications.go:44
#: internal/modules/account/notifications.go:46
msgid "Email me if this alert gets turned off"
msgstr "Küldjön e-mailt, ha ezt a riasztást kikapcsolják"

#: internal/modules/account/notifications.go:39
msgid "Contact email changed"
msgstr "Kapcsolattartási e-mail megváltozott"

#: internal/modules/account/notifications.go:39
msgid ""
"Get an email when the contact email address for your account is changed."
msgstr "Kapjon e-mailt, ha megváltozik a fiókja kapcsolattartási e-mail-címe."

#: internal/modules/account/notifications.go:41
msgid "Two-factor authentication changed"
msgstr "Kétfaktoros hitelesítés megváltozott"

#: internal/modules/account/notifications.go:41
msgid "Get an email when two-factor authentication is turned on or off."
msgstr "Kapjon e-mailt, ha a kétfaktoros hitelesítést be- vagy kikapcsolják."

#: internal/modules/account/notifications.go:43
msgid "Passkey added or removed"
msgstr "Passkey hozzáadva vagy eltávolítva"

#: internal/modules/account/notifications.go:43
msgid ""
"Get an email when a passkey is added to your account or removed from it."
msgstr ""
"Kapjon e-mailt, ha passkey-t adnak a fiókjához vagy eltávolítanak belőle."

#: internal/modules/account/notifications.go:45
msgid "API token created or revoked"
msgstr "API-token létrehozva vagy visszavonva"

#: internal/modules/account/notifications.go:45
msgid ""
"Get an email when an AI Assistant (MCP) token is created or revoked for your"
" account."
msgstr ""
"Kapjon e-mailt, ha AI asszisztens (MCP) tokent hoznak létre vagy vonnak "
"vissza a fiókjához."

#: internal/modules/account/notifications.go:47
msgid "SSL certificate problem"
msgstr "SSL-tanúsítvány probléma"

#: internal/modules/account/notifications.go:47
msgid ""
"Get an email when an SSL certificate fails to renew or is about to expire, "
"before visitors see a security warning."
msgstr ""
"Kapjon e-mailt, ha egy SSL-tanúsítvány megújítása sikertelen vagy hamarosan "
"lejár, mielőtt a látogatók biztonsági figyelmeztetést látnának."

#: internal/modules/account/notifications.go:48
msgid "Malware found"
msgstr "Kártevő található"

#: internal/modules/account/notifications.go:48
msgid "Get an email when a malware scan finds infected files on your account."
msgstr ""
"Kapjon e-mailt, ha egy kártevővizsgálat fertőzött fájlokat talál a "
"fiókjában."

#: internal/modules/account/notifications.go:49
msgid "Vulnerable WordPress site"
msgstr "Sérülékeny WordPress oldal"

#: internal/modules/account/notifications.go:49
msgid ""
"Get an email when WordPress, a plugin or a theme on one of your websites has"
" a known security vulnerability."
msgstr ""
"Kapjon e-mailt, ha valamelyik weboldalán a WordPressnek, egy bővítménynek "
"vagy egy témának ismert biztonsági rése van."

#: internal/modules/account/notifications.go:50
msgid "Disk space running out"
msgstr "Fogy a lemezterület"

#: internal/modules/account/notifications.go:50
msgid ""
"Get an email when your account uses 85% of its disk space or 95% of its "
"inodes."
msgstr ""
"Kapjon e-mailt, ha a fiókja a lemezterület 85%-át vagy az inode-ok 95%-át "
"használja."

#: internal/modules/account/notifications.go:51
msgid "Mailbox almost full"
msgstr "A postafiók majdnem megtelt"

#: internal/modules/account/notifications.go:51
msgid "Get an email when one of your email accounts uses 90% of its quota."
msgstr ""
"Kapjon e-mailt, ha valamelyik e-mail-fiókja a kvótája 90%-át használja."

#: internal/modules/account/notifications.go:52
msgid "Hourly email limit reached"
msgstr "Elérte az óránkénti e-mail-korlátot"

#: internal/modules/account/notifications.go:52
msgid ""
"Get an email when your account reaches its limit of emails sent per hour and"
" new emails are rejected."
msgstr ""
"Kapjon e-mailt, ha a fiókja eléri az óránként küldhető e-mailek korlátját, "
"és az új e-maileket elutasítják."

#: internal/modules/account/notifications.go:53
msgid "Service stopped"
msgstr "Szolgáltatás leállt"

#: internal/modules/account/notifications.go:53
msgid ""
"Get an email when a service like MySQL or PHP stopped or ran out of memory "
"and had to be restarted."
msgstr ""
"Kapjon e-mailt, ha egy szolgáltatás, például a MySQL vagy a PHP leállt, vagy"
" elfogyott a memóriája, és újra kellett indítani."

#: internal/modules/account/notifications.go:54
msgid "Visitors blocked by rate limit"
msgstr "Kéréskorlát miatt letiltott látogatók"

#: internal/modules/account/notifications.go:54
msgid ""
"Get an email when visitors to one of your domains were blocked for sending "
"too many requests per minute."
msgstr ""
"Kapjon e-mailt, ha valamelyik domainjének látogatóit letiltották, mert túl "
"sok kérést küldtek percenként."

#: internal/modules/account/notifications.go:55
msgid "Daily summary"
msgstr "Napi összefoglaló"

#: internal/modules/account/notifications.go:55
msgid ""
"Get one email each morning with what needs your attention on your account "
"and websites, and the day's traffic, logins and changes."
msgstr ""
"Kapjon minden reggel e-mailt arról, ami figyelmet igényel a fiókjában és "
"weboldalain, valamint a nap forgalmáról, bejelentkezéseiről és "
"változásairól."

#: internal/modules/account/notifications.go:56
msgid "Daily error report"
msgstr "Napi hibajelentés"

#: internal/modules/account/notifications.go:56
msgid ""
"Get one email a day with the errors found in your websites' logs in the last"
" 24 hours, the same ones shown on the Error Logs page."
msgstr ""
"Kapjon naponta egy e-mailt a weboldalai naplóiban az elmúlt 24 órában talált"
" hibákról, ugyanazokról, amelyek a Hibanaplók oldalon látszanak."

#: internal/modules/account/notifications.go:197
msgid "Notification preferences updated successfully!"
msgstr "Értesítési beállítások sikeresen frissítve!"

