msgid "Create a database"
msgstr "Adatbázis létrehozása"

#: openpanel/internal/web/templates/dashboard/onboarding.html:389
msgid "Set up a new database and user with the database wizard."
msgstr "Hozzon létre új adatbázist és felhasználót az adatbázis-varázslóval."

#: openpanel/internal/web/templates/dashboard/onboarding.html:395
msgid "Add a website"
msgstr "Weboldal hozzáadása"

#: openpanel/internal/web/templates/dashboard/onboarding.html:396
msgid "Install WordPress or another app with the auto-installer."
msgstr ""
"Telepítsen WordPress-t vagy más alkalmazást az automatikus telepítővel."

#: openpanel/internal/web/templates/dashboard/onboarding.html:407
msgid "Skip"
msgstr "Kihagyás"

#: openpanel/internal/web/templates/dashboard/onboarding.html:410
#: openpanel/internal/web/templates/dashboard/onboarding.html:572
msgid "Finish"
msgstr "Befejezés"

#: openpanel/internal/web/templates/dashboard/onboarding.html:410
msgid "Continue"
msgstr "Folytatás"

#: openpanel/internal/web/templates/dashboard/onboarding.html:411
msgid "Please wait…"
msgstr "Kérjük, várjon…"

#: openpanel/internal/web/templates/dashboard/onboarding.html:434
msgid "Recommended for websites that use .htaccess for rewrite rules."
msgstr ""
"Ajánlott olyan weboldalakhoz, amelyek .htaccess fájlt használnak az "
"átirányítási szabályokhoz."

#: openpanel/internal/web/templates/dashboard/onboarding.html:439
msgid ""
"Recommended for NodeJS and Python applications, and high-traffic sites."
msgstr ""
"Ajánlott NodeJS és Python alkalmazásokhoz, valamint magas forgalmú "
"oldalakhoz."

#: openpanel/internal/web/templates/dashboard/onboarding.html:444
msgid "Recommended for WordPress websites, but only one PHP version."
msgstr "Ajánlott WordPress weboldalakhoz, de csak egy PHP verzió használható."

#: openpanel/internal/web/templates/dashboard/onboarding.html:479
msgid "Nginx core bundled with Lua scripting for custom logic."
msgstr "Nginx alapmag Lua szkriptelési lehetőséggel egyéni logikához."

#: openpanel/internal/web/templates/dashboard/onboarding.html:489
msgid "Can be better fine-tuned for any type of application."
msgstr "Bármilyen típusú alkalmazáshoz jobban finomhangolható."

#: openpanel/internal/web/templates/dashboard/onboarding.html:494
msgid ""
"Recommended for WordPress sites - smaller image, lower resource usage, and "
"faster default query execution."
msgstr ""
"Ajánlott WordPress oldalakhoz - kisebb image méret, alacsonyabb erőforrás-"
"használat és gyorsabb alapértelmezett lekérdezés-végrehajtás."

