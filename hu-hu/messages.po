msgstr "Weboldal fájljainak visszaállítása egy korábbi biztonsági mentésből."

#: openpanel/internal/web/templates/manager/websitebuilder.html:207
msgid "Remove the website from WP Manager."
msgstr "Weboldal eltávolítása a WP Managerből."

#: openpanel/internal/web/templates/manager/websitebuilder.html:214
msgid "Detach website"
msgstr "A honlap kiválasztása"

#: openpanel/internal/web/templates/manager/websitebuilder.html:217
